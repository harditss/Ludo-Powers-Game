    private func refreshDebugPanel() {
        guard debugModeEnabled else { return }
        if let s = debugStagedRoll {
            debugStagedLabel?.text = "Next die: \(s) (tap die to apply)"
        } else {
            debugStagedLabel?.text = "Next die: random (tap 1–6 to stage)"
        }
        var lines: [String] = []
        lines.append("Turn: \(engine.currentSeat.displayName)")
        lines.append("Finish order: \(engine.finishOrder.map(\.displayName).joined(separator: ", "))")
        for seat in LudoSeat.allCases where LudoSeat.activeSeats(forPlayerCount: playerCount).contains(seat) {
            if let sp = engine.spot(for: seat, tokenId: 0) {
                lines.append("\(seat.displayName) t0: \(debugSpotSummary(sp))")
            }
        }
        let fork = LudoBoardPath.publicPathForkIndexBeforeHomeColumn(for: .green)
